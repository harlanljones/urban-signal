{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "urban-signal-product",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-24",
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false
  }
}
