{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "urban-signal-webhook-receiver",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "hooks.harlanljones.com",
      "custom_domain": true
    }
  ]
}
