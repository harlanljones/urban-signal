{
  "type": "record",
  "name": "PoiChangeEvent",
  "namespace": "org.urbandev.events",
  "doc": "Business opening/closing detected from a POI release delta (US-363 §1.3). Never an SLALicenseEvent: a license is a government authorization, a POI detection is a vendor observation.",
  "fields": [
    { "name": "city_id", "type": "string", "default": "nyc" },
    { "name": "poi_id", "type": "string" },
    { "name": "source", "type": "string", "default": "fsq" },
    { "name": "event_type", "type": "string" },
    { "name": "name", "type": ["null", "string"], "default": null },
    { "name": "category", "type": ["null", "string"], "default": null },
    { "name": "category_id", "type": ["null", "string"], "default": null },
    { "name": "confidence", "type": "double", "default": 1.0 },
    { "name": "release_id", "type": ["null", "string"], "default": null },
    { "name": "action", "type": ["null", "string"], "default": null },
    { "name": "borough", "type": ["null", "string"], "default": null },
    { "name": "address", "type": ["null", "string"], "default": null },
    { "name": "latitude", "type": "double" },
    { "name": "longitude", "type": "double" },
    { "name": "event_date", "type": "string" },
    { "name": "h3_res7", "type": ["null", "string"], "default": null },
    { "name": "h3_res8", "type": ["null", "string"], "default": null },
    { "name": "h3_res9", "type": ["null", "string"], "default": null },
    { "name": "ingested_at", "type": "string" }
  ]
}
