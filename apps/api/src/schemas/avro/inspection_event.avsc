{
  "type": "record",
  "name": "InspectionEvent",
  "namespace": "org.urbandev.events",
  "doc": "Municipal food-establishment inspection / licensing outcome",
  "fields": [
    { "name": "city_id", "type": "string", "default": "boston" },
    { "name": "inspection_id", "type": "string" },
    { "name": "business_name", "type": ["null", "string"], "default": null },
    { "name": "license_category", "type": ["null", "string"], "default": null },
    { "name": "license_status", "type": ["null", "string"], "default": null },
    { "name": "result", "type": ["null", "string"], "default": null },
    { "name": "violation_level", "type": ["null", "string"], "default": null },
    { "name": "violation_desc", "type": ["null", "string"], "default": null },
    { "name": "borough", "type": ["null", "string"], "default": null },
    { "name": "address", "type": ["null", "string"], "default": null },
    { "name": "zipcode", "type": ["null", "string"], "default": null },
    { "name": "latitude", "type": ["null", "double"], "default": null },
    { "name": "longitude", "type": ["null", "double"], "default": null },
    { "name": "issued_date", "type": ["null", "string"], "default": null },
    { "name": "result_date", "type": ["null", "string"], "default": null },
    { "name": "h3_res7", "type": ["null", "string"], "default": null },
    { "name": "h3_res8", "type": ["null", "string"], "default": null },
    { "name": "h3_res9", "type": ["null", "string"], "default": null },
    { "name": "ingested_at", "type": "string" }
  ]
}