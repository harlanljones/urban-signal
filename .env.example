# Urban Signal — environment variables
# Copy this file to .env and replace every CHANGE_ME value.
# This file is safe to commit; .env is gitignored.

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
SERVICE_NAME=urban-signal-predictor

# ── Kafka ─────────────────────────────────────────────────────────────────────
# In the full compose stack the internal broker address is used:
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_SCHEMA_REGISTRY_URL=http://schema-registry:8081
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# ── PostgreSQL / PostGIS ──────────────────────────────────────────────────────
POSTGRES_HOST=postgis
POSTGRES_PORT=5432
POSTGRES_DB=urbansignal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# ── MinIO S3 ──────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET_FEATURES=urban-signal-features
MINIO_SECURE=false

# ── ML Inference ──────────────────────────────────────────────────────────────
ONNX_MODEL_DIR=./models_storage
ONNX_EXECUTION_PROVIDER=CPUExecutionProvider   # CPUExecutionProvider | CUDAExecutionProvider
GPU_DEVICE_ID=0

# ── Feature Parameters ────────────────────────────────────────────────────────
H3_RES_MACRO=7
H3_RES_NEIGHBORHOOD=8
H3_RES_MICRO=9
CAPEX_HALFLIFE_DAYS=180.0
LIMS_THRESHOLD=85.0

# ── Scheduler Watermark Persistence (US-106) ──────────────────────────────────
# Path to JSON file holding per-job high watermarks; empty disables persistence
SCHEDULER_STATE_FILE=/data/watermarks.json

# ── Socrata Open Data API ─────────────────────────────────────────────────────
# Obtain a free token at https://data.cityofnewyork.us/profile/app_tokens or https://data.sfgov.org/profile/app_tokens
SOCRATA_APP_TOKEN=
# SOCRATA_SF_DOB_ENDPOINT=https://data.sfgov.org/resource/i98e-djp9.json
# SOCRATA_SF_311_ENDPOINT=https://data.sfgov.org/resource/vw6y-z8j6.json
# SOCRATA_SF_LICENSES_ENDPOINT=https://data.sfgov.org/resource/g8m3-pdis.json
# SOCRATA_SF_DEEDS_ENDPOINT=https://data.sfgov.org/resource/wv5m-vpq2.json

# ── Address Geocoding (ADR 0004) ──────────────────────────────────────────────
GEOCODE_CONFIDENCE_FLOOR=0.9
GEOCODE_BACKEND=census                           # census | nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ── Census Data API (US-361) ───────────────────────────────────────────────────
# Free key for ACS and other Census APIs; required for live ACS pulls.
# Obtain at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# ── Webhook Alerts ────────────────────────────────────────────────────────────
# JSON array of URLs that receive catalyst alert payloads
WEBHOOK_ALERT_URLS=[]
